# Copy to .env (gitignored) and fill in. Loaded automatically by spring-dotenv.
DB_URL=jdbc:mysql://localhost:3306/collabro
DB_USERNAME=
DB_PASSWORD=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# At least 32 characters of randomness, e.g.: openssl rand -hex 32
JWT_SECRET=

